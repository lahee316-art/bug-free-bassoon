  /* ---------- 1세(연두반) · 2세(하늘반) 2학기 상담지 ---------- */
  var T12_INTRO = T0_INTRO;
  var PH = "자유롭게 적어 주세요.";

  function pdfSections(S) {
    function c(id, n, short, label, opts) { return { id: id, label: n + ". " + label, short: short, type: "check", other: true, opts: opts }; }
    function t(id, n, short, label, ph) { return { id: id, label: n + ". " + label, short: short, type: "textarea", ph: ph || PH }; }
    return [
      { id: "me", title: "기본 정보", hint: "", qs: [
        { id: "child", label: "영유아명", short: "영유아명", type: "text", req: true, ph: "예) 하준이" },
        { id: "who", label: "작성하시는 분", short: "작성자", type: "radio", req: true, opts: ["어머니", "아버지", "조부모님"], other: true }
      ]},
      { id: "growth", title: "우리 아이의 성장과 변화", hint: "", qs: [
        c("g1", 1, "변화", "1학기와 비교하여 요즘 아이에게 가장 크게 느껴지는 변화는 무엇인가요?", S.g1),
        t("g2", 2, "새로 할 수 있게 된 것", "요즘 아이를 보며 “이런 것도 할 수 있게 되었구나!”라고 느낀 모습은 무엇인가요?"),
        t("g3", 3, "강점", "1학기 이후 새롭게 발견한 우리 아이의 강점이나 좋은 모습은 무엇인가요?")
      ]},
      { id: "life", title: "일상에서 자라는 모습", hint: "", qs: [
        c("l1", 1, "스스로 하는 것", S.l1q, S.l1),
        c("l2", 2, "스스로 할 때 모습", S.l2q, S.l2),
        t("l3", 3, "생활 변화", S.l3q, "없으면 비워 두셔도 돼요."),
        t("l4", 4, "생활습관·건강", "생활습관이나 건강과 관련하여 어린이집과 함께 살펴보거나 같은 방향으로 도와주고 싶은 부분이 있나요?")
      ]},
      { id: "play", title: "놀이 속에서 자라는 모습", hint: "", qs: S.playQs(c, t) },
      { id: "fwd", title: "함께 바라보는 우리 아이", hint: "", qs: S.fwdQs(c, t) }
    ];
  }

  var SPEC1 = {
    g1: ["걷고 움직이는 것이 능숙해짐", "주변의 물건을 적극적으로 살펴보고 만져봄", "말이나 몸짓으로 원하는 것을 표현함", "어른의 말이나 행동을 따라 하는 모습이 많아짐", "혼자 해보려는 모습이 많아짐", "주변 사람이나 또래에게 관심을 보임"],
    l1q: "요즘 아이가 일상에서 스스로 해보려고 하는 것은 무엇인가요?",
    l1: ["숟가락이나 포크로 먹어보기", "컵을 들고 마셔보기", "옷·양말·신발을 벗거나 입어보기", "손 씻기·양치에 참여하기", "놀잇감이나 자신의 물건 정리하기", "배변 전·후를 말이나 행동으로 표현하기"],
    l2q: "아이가 스스로 해보려고 할 때 주로 어떤 모습을 보이나요?",
    l2: ["먼저 혼자 해보려고 시도함", "어른의 행동을 보고 따라 해봄", "잘되지 않아도 다시 시도해봄", "어려우면 어른에게 도움을 요청함", "도움을 받기보다 혼자 하겠다는 의사를 표현하기도 함", "상황에 따라 어른의 도움이 많이 필요함"],
    l3q: "식사·수면·배변 등 생활습관에서 1학기 이후 달라진 모습이 있다면 적어주세요.",
    playQs: function (c, t) {
      return [
        c("p1", 1, "놀이 모습", "요즘 아이의 놀이에서 어떤 모습이 많이 나타나나요?", ["좋아하는 놀이를 여러 번 반복함", "넣고 빼기·쌓기·옮기기를 즐김", "어른이나 친구의 행동을 따라 해봄", "먹이기·전화하기 등 생활 모습을 흉내 냄", "놀잇감을 여러 방법으로 사용해봄", "친구의 놀이를 바라보거나 가까이에서 놀이함"]),
        t("p2", 2, "즐기는 놀이", "요즘 아이가 특히 좋아하거나 반복해서 찾는 놀이와 관심거리는 무엇이며, 이전과 달라진 점이 있다면 적어주세요."),
        c("p3", 3, "마음 표현", "아이가 원하는 것이나 자신의 마음을 주로 어떻게 표현하나요?", ["손가락으로 가리키거나 몸짓으로 표현함", "원하는 것을 직접 가져옴", "알고 있는 말로 표현함", "어른의 손을 잡고 원하는 곳으로 이끎", "표정·울음·행동으로 표현함", "여러 방법을 함께 사용함"]),
        t("p4", 4, "말·의사표현", "최근 아이의 말이나 의사표현에서 새롭게 나타난 모습이 있다면 적어주세요.")
      ];
    },
    fwdQs: function (c, t) {
      return [
        c("f1", 1, "듣고 싶은 모습", "이번 상담에서 선생님께 가장 듣고 싶은 아이의 모습은 무엇인가요?", ["아이가 잘하고 있는 점과 강점", "1학기 이후 달라진 성장 모습", "좋아하고 몰입하는 놀이와 관심거리", "말과 의사소통 모습", "감정을 표현하고 조절해가는 모습", "또래·교사와의 관계", "식사·수면·배변 등 생활습관", "스스로 해보는 생활 모습", "앞으로 더 지원해 주면 좋을 부분"]),
        t("f2", 2, "양육 중 궁금한 점", "요즘 아이를 양육하면서 “왜 이런 모습을 보일까?”, “어떻게 도와주면 좋을까?” 하고 궁금했던 것이 있나요?"),
        t("f3", 3, "바라는 성장·요구사항", "앞으로 아이가 하늘반(만2세반)이 되어서 조금 더 경험하거나 성장했으면 하는 부분과 어린이집에 요구사항은?"),
        t("f4", 4, "나누고 싶은 이야기", "그 밖에 이번 상담에서 선생님과 꼭 나누고 싶은 이야기나 질문이 있다면 자유롭게 적어주세요.")
      ];
    }
  };

  var SPEC2 = {
    g1: ["스스로 하려는 모습이 많아짐", "말로 표현하는 것이 많아짐", "궁금한 것을 자주 질문함", "경험한 일을 놀이로 표현함", "친구와 함께 놀이하는 모습이 많아짐", "좋고 싫음을 분명하게 표현함", "약속이나 순서를 따르는 모습이 많아짐"],
    l1q: "요즘 아이가 일상에서 스스로 하는 모습이 많아진 것은 무엇인가요?",
    l1: ["숟가락·포크를 사용하여 식사하기", "옷·양말·신발을 입거나 벗기", "손 씻기·양치하기", "배변 의사를 표현하거나 화장실 이용하기", "자신의 물건이나 놀잇감 정리하기", "필요한 것을 말로 요청하기", "간단한 일이나 심부름에 참여하기"],
    l2q: "일상에서 해야 하는 일이나 약속이 있을 때 아이는 주로 어떻게 하나요?",
    l2: ["스스로 알고 해보려고 함", "알려주면 해보려고 함", "어른과 함께하면 참여함", "여러 번 안내가 필요함", "하기 싫은 마음을 말이나 행동으로 강하게 표현하기도 함", "상황에 따라 다름"],
    l3q: "식사·수면·배변·위생 등 생활습관에서 1학기 이후 달라진 모습이 있다면 적어주세요.",
    playQs: function (c, t) {
      return [
        c("p1", 1, "놀이 모습", "요즘 아이의 놀이에서 어떤 모습이 많이 나타나나요?", ["좋아하는 놀이를 오래 이어서 즐김", "경험한 일을 놀이로 표현함", "역할을 정하거나 다른 사람의 모습을 흉내 내며 놀이함", "놀잇감을 새로운 방법으로 사용하며 놀이를 확장함", "궁금한 것을 묻거나 직접 해보며 알아봄", "자신의 생각을 말하며 놀이를 이끌어감", "친구에게 다가가거나 함께 놀이하려고 함"]),
        t("p2", 2, "즐기는 놀이", "요즘 아이가 특히 좋아하는 놀이와 관심거리는 무엇이며, 이전과 달라진 점이 있다면 적어주세요."),
        c("p3", 3, "뜻대로 안 될 때", "자신의 뜻대로 되지 않거나 기다려야 할 때 아이는 주로 어떻게 하나요?", ["자신의 마음이나 요구를 말로 표현함", "울음이나 큰 행동으로 감정을 표현하기도 함", "어른에게 도움이나 위로를 요청함", "설명을 들으면 조금씩 기다려봄", "다른 방법을 제안하면 받아들이기도 함", "도움을 받으며 마음을 진정함", "스스로 마음을 진정하거나 다른 것으로 관심을 전환하기도 함"]),
        t("p4", 4, "말·의사소통", "최근 아이의 말과 의사소통에서 어떤 모습이 많이 나타나나요?"),
        t("p5", 5, "친구와 함께할 때", "친구와 함께 있을 때 어떤 모습이 많이 나타나나요?")
      ];
    },
    fwdQs: function (c, t) {
      return [
        c("f1", 1, "듣고 싶은 모습", "이번 상담에서 선생님께 가장 듣고 싶은 아이의 모습은 무엇인가요?", ["아이가 잘하고 있는 점과 강점", "1학기 이후 달라진 성장 모습", "좋아하고 몰입하는 놀이와 관심거리", "말과 의사소통 모습", "감정을 표현하고 조절해가는 모습", "친구와 놀이하고 관계를 맺는 모습", "식사·수면·배변 등 생활습관", "스스로 하는 생활 모습", "약속이나 규칙을 경험하는 모습", "앞으로 더 지원해 주면 좋을 부분"]),
        t("f2", 2, "양육 중 궁금한 점", "요즘 아이를 양육하면서 “왜 이런 모습을 보일까?”, “어떻게 도와주면 좋을까?” 하고 궁금했던 것이 있나요?"),
        t("f3", 3, "바라는 성장", "앞으로 아이가 조금 더 경험하거나 성장했으면 하는 부분은 무엇인가요?"),
        t("f4", 4, "졸업 후 기관", "공립증평주공어린이집을 졸업하면서 다른 시설로 갑니다. 예상하고 있는 어린이집이나 유치원은 어디인가요?", "예) 증평초병설유치원, 아직 미정")
      ];
    }
  };

  function specFor(age) { return age === "t1" ? SPEC1 : SPEC2; }
  function isPdf(age) { return age === "t0" || age === "t1" || age === "t2"; }

  var T12_COLS = [
    { head: "영유아명", ids: ["child"], w: 6 },
    { head: "작성자", ids: ["who"], w: 5 },
    { head: "성장과 변화", ids: ["g1", "g2", "g3"], w: 21, labeled: true },
    { head: "일상에서 자라는 모습", ids: ["l1", "l2", "l3", "l4"], w: 24, labeled: true },
    { head: "놀이 속에서 자라는 모습", ids: ["p1", "p2", "p3", "p4", "p5"], w: 22, labeled: true },
    { head: "함께 바라보는 우리 아이", ids: ["f1", "f2", "f3", "f4"], w: 22, labeled: true }
  ];

  function intro(age) {
    if (age === "t0" || age === "t1" || age === "t2") return T0_INTRO;
    return "우리 아이의 요즘 모습과 궁금한 점을 상담 전에 적어 주시면, 상담 시간을 더 알차게 쓸 수 있어요. 아는 만큼만, 편하게 골라 주세요.";
  }

  function formTitle(cls) {
    if (isPdf(cls.age)) return cls.name + " 2학기 부모 상담 사전 질문지";
    return cls.name + " 부모 상담 미리 적어보기";
  }

  function labelMap(age) {
    var m = {};
    sections(age).forEach(function (s) { s.qs.forEach(function (q) { m[q.id] = q.short || ""; }); });
    return m;
  }

  function sections(age) {
    if (age === "t0") return t0Sections();
    if (age === "t1" || age === "t2") return pdfSections(specFor(age));
    var a = AGES[age] || AGES["1"];
    var home = [
      { id: "move", label: a.moveQ, short: a.moveQ, type: "radio", opts: a.move },
      { id: "eat", label: "식사", short: "식사", type: "check", opts: a.eat, other: true },
      { id: "sleep", label: "낮잠과 밤잠", short: "수면", type: "check", opts: a.sleep, other: true }
    ];
    if (a.potty) home.push({ id: "potty", label: "배변", short: "배변", type: "radio", opts: a.potty });
    home.push({ id: "talk", label: a.talkQ, short: "말", type: "radio", opts: a.talk });
    home.push({ id: "play", label: "좋아하는 놀이", short: "놀이", type: "check", opts: a.play, other: true });
    home.push({ id: "sep", label: "부모님과 헤어질 때", short: "분리", type: "radio", opts: a.sep });
    home.push({ id: "health", label: "알레르기·복용 약·건강상 알려 주실 점 (선택)", short: "건강", type: "textarea", ph: "없으면 비워 두셔도 돼요." });

    var stat = ["지금 우리 반에 다니고 있어요", "입소가 정해져서 준비 중이에요", "입소 대기 중이에요", "입소할지 고민 중이에요"];

    return [
      { id: "me", title: "우리 아이 소개", hint: "아이 이름은 애칭도 괜찮아요.", qs: [
        { id: "child", label: "아이 이름(또는 애칭)", short: "아이", type: "text", req: true, ph: "예) 하준이" },
        { id: "months", label: a.ageQ, short: "월령·나이", type: "radio", req: true, opts: a.ageOpts },
        { id: "who", label: "상담에 오시는 분", short: "보호자", type: "radio", req: true, opts: ["어머니", "아버지", "조부모님"], other: true }
      ]},
      { id: "enroll", title: "재원 여부", hint: "해당하는 것 하나를 골라 주세요.", qs: [
        { id: "status", label: "현재 어떤 상황이세요?", short: "재원", type: "radio", req: true, opts: stat },
        { id: "when", label: "입소를 희망하는 시기", short: "입소 희망", type: "text", ph: "예) 내년 3월, 되도록 빨리",
          showIf: { id: "status", values: [stat[1], stat[2], stat[3]] } },
        { id: "adapt", label: "어린이집 생활은 어떤 것 같으세요?", short: "적응", type: "radio",
          opts: ["즐겁게 잘 지내요", "아침마다 많이 울어요", "아직 적응하는 중이에요", "잘 모르겠어요"],
          showIf: { id: "status", values: [stat[0]] } }
      ]},
      { id: "home", title: "집에서의 모습", hint: "해당하는 것을 골라 주세요. 정답은 없어요.", qs: home },
      { id: "ask", title: "어린이집에서 더 알고 싶은 점", hint: "궁금한 것을 모두 골라 주세요.", qs: [
        { id: "topics", label: "알고 싶은 내용", short: "알고 싶은 점", type: "check", opts: BASE_TOPICS.concat(a.topicsExtra), other: true },
        { id: "ask1", label: "가장 궁금한 것 한 가지", short: "가장 궁금한 것", type: "textarea", ph: "상담 때 가장 먼저 여쭙고 싶은 것을 적어 주세요." }
      ]},
      { id: "last", title: "마지막으로", hint: "", qs: [
        { id: "wish", label: "어린이집에 바라는 점이나 집에서 하는 고민", short: "바라는 점", type: "textarea", ph: "자유롭게 적어 주세요." }
      ]}
    ];
  }

  var TABLE_COLS = [
    { head: "아이", ids: ["child"], w: 6 },
    { head: "월령·나이", ids: ["months"], w: 6 },
    { head: "보호자", ids: ["who"], w: 5 },
    { head: "재원", ids: ["status", "when", "adapt"], w: 9 },
    { head: "움직임·자조", ids: ["move"], w: 6 },
    { head: "식사", ids: ["eat"], w: 8 },
    { head: "수면", ids: ["sleep"], w: 8 },
    { head: "배변", ids: ["potty"], w: 5 },
    { head: "말", ids: ["talk"], w: 6 },
    { head: "놀이", ids: ["play"], w: 8 },
    { head: "분리", ids: ["sep"], w: 5 },
    { head: "건강", ids: ["health"], w: 8 },
    { head: "알고 싶은 점", ids: ["topics", "ask1"], w: 10 },
    { head: "바라는 점", ids: ["wish"], w: 9 }
  ];

  function ageIds(age) {
    var ids = {};
    sections(age).forEach(function (s) { s.qs.forEach(function (q) { ids[q.id] = 1; }); });
    return ids;
  }

  function colsFor(age) {
    if (age === "t0") return T0_COLS;
    if (age === "t1" || age === "t2") return T12_COLS;
    var ids = ageIds(age);
    return TABLE_COLS.filter(function (c) {
      return c.ids.some(function (i) { return ids[i]; });
    });
  }

  return { AGES: AGES, AGE_LIST: AGE_LIST, sections: sections, colsFor: colsFor, intro: intro, formTitle: formTitle, labelMap: labelMap };
})();
