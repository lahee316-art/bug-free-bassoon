  var T0_INTRO = "안녕하세요, 공립증평주공어린이집입니다. 1학기 상담 이후 한층 성장한 아이의 모습을 가정과 어린이집이 함께 나누고자 합니다. 이번 상담에서는 가정에서 느끼신 성장과 변화, 어린이집에서 관찰한 발달 모습을 함께 살펴보며 아이의 강점과 앞으로의 지원 방향을 이야기하고자 합니다. 평소 아이의 모습을 떠올리며 편안하게 작성해 주세요. 상담 사전 질문지는 10월 21일(수)까지 작성해 주세요.";

  function t0Sections() {
    return [
      { id: "me", title: "기본 정보", hint: "", qs: [
        { id: "child", label: "영유아명", short: "영유아명", type: "text", req: true, ph: "예) 하준이" },
        { id: "who", label: "작성하시는 분", short: "작성자", type: "radio", req: true, opts: ["어머니", "아버지", "조부모님"], other: true }
      ]},
      { id: "growth", title: "우리 아이의 성장과 변화", hint: "", qs: [
        { id: "g1", label: "1. 1학기와 비교하여 요즘 아이에게 가장 크게 느껴지는 변화는 무엇인가요?", short: "변화", type: "check", other: true,
          opts: ["기기·서기·걷기 등 움직임이 많아짐", "말이나 행동을 따라 하려는 모습이 많아짐", "장난감이나 주변 물건을 만지고 살펴봄", "원하는 곳으로 가거나 물건을 직접 선택함", "표정·소리·몸짓으로 원하는 것을 표현함", "익숙한 사람을 알아보고 반가워함"] },
        { id: "g2", label: "2. 요즘 아이를 보며 “이런 것도 할 수 있게 되었구나!”라고 느낀 모습은 무엇인가요?", short: "새로 할 수 있게 된 것", type: "textarea", ph: "자유롭게 적어 주세요." },
        { id: "g3", label: "3. 1학기 이후 새롭게 발견한 우리 아이의 강점이나 좋은 모습은 무엇인가요?", short: "강점", type: "textarea", ph: "자유롭게 적어 주세요." }
      ]},
      { id: "life", title: "일상에서 자라는 모습", hint: "", qs: [
        { id: "l1", label: "1. 최근 아이의 식사 모습에서 해당되는 것을 선택해 주세요.", short: "식사", type: "check", other: true,
          opts: ["수유를 하고 있음", "스스로 음식을 집거나 먹어보려고 함", "이유식을 먹고 있음", "음식에 대한 선호가 분명해지고 있음", "유아식을 경험하고 있음", "새로운 음식이나 식감을 시도하고 있음"] },
        { id: "l2", label: "2. 아이가 피곤하거나 졸릴 때 주로 어떤 신호를 보이나요?", short: "졸릴 때 신호", type: "check", other: true,
          opts: ["하품하거나 눈을 비빔", "평소 사용하는 말·소리·몸짓으로 표현함", "칭얼거리거나 울음으로 표현함", "일정한 시간대에 졸려함", "활동이 줄어들거나 안기려고 함"] },
        { id: "l3", label: "3. 수유·식사, 수면, 배변 등 생활에서 1학기 이후 달라진 모습이 있다면 적어주세요.", short: "생활 변화", type: "textarea", ph: "없으면 비워 두셔도 돼요." },
        { id: "l4", label: "4. 아이가 힘들거나 불편할 때 편안해지는 데 도움이 되는 방법이 있다면 알려주세요.", short: "편안해지는 방법", type: "textarea", ph: "자유롭게 적어 주세요." },
        { id: "l5", label: "5. 최근 건강 상태나 어린이집에서 새롭게 참고해야 할 사항이 있나요?", short: "건강·참고", type: "radio", opts: ["특별한 사항 없음", "있음"] },
        { id: "l5n", label: "참고해야 할 사항을 적어 주세요", short: "참고 내용", type: "textarea", ph: "예) 알레르기, 복용 중인 약, 최근 아팠던 일", showIf: { id: "l5", values: ["있음"] } }
      ]},
      { id: "play", title: "놀이 속에서 자라는 모습", hint: "", qs: [
        { id: "p1", label: "1. 요즘 아이가 주변을 탐색하거나 놀이할 때 어떤 모습이 많이 나타나나요?", short: "탐색·놀이 모습", type: "check", other: true,
          opts: ["손으로 만지고 두드리거나 흔들어보며 탐색함", "어른의 표정·소리·행동을 따라 해봄", "입·손·몸 등 여러 감각을 활용하여 탐색함", "익숙한 사물의 사용 방법을 흉내 내며 놀이함", "기어가거나 걸어가며 관심 있는 곳을 찾아감", "관심 있는 것을 발견하면 오래 바라보거나 집중함", "같은 행동이나 놀이를 여러 번 반복함"] },
        { id: "p2", label: "2. 요즘 아이가 특히 관심을 보이거나 반복해서 즐기는 놀이나 행동은 무엇인가요?", short: "즐기는 놀이", type: "textarea", ph: "자유롭게 적어 주세요." },
        { id: "p3", label: "3. 아이가 보호자와 함께 놀이할 때 어떤 모습을 많이 보이나요?", short: "보호자와 놀이", type: "check", other: true,
          opts: ["보호자의 얼굴이나 눈을 바라봄", "보호자의 행동을 따라 해보려고 함", "보호자의 말이나 표정에 웃음·소리·몸짓으로 반응함", "가까이에서 함께 놀이하는 것을 즐김", "까꿍이나 주고받기처럼 반복되는 놀이를 즐김", "관심 있는 것을 보여주거나 함께 바라보려고 함"] },
        { id: "p4", label: "4. 최근 아이의 말이나 의사표현에서 새롭게 나타난 모습은 무엇인가요?", short: "말·의사표현", type: "check", other: true,
          opts: ["다양한 소리나 옹알이를 자주 냄", "간단한 말이나 행동을 이해하고 반응함", "이름을 부르거나 익숙한 말을 들으면 반응함", "익숙한 말이나 단어를 사용하기 시작함", "표정·몸짓·손짓으로 원하는 것을 표현함", "어른의 소리나 말을 따라 해보려고 함", "관심 있는 것을 가리키거나 보여줌"] }
      ]},
      { id: "fwd", title: "함께 바라보는 우리 아이", hint: "", qs: [
        { id: "f1", label: "1. 이번 상담에서 선생님께 가장 듣고 싶은 아이의 모습은 무엇인가요?", short: "듣고 싶은 모습", type: "check", other: true,
          opts: ["어린이집에서 편안하고 안정적으로 지내는 모습", "교사와 관계를 맺고 상호작용하는 모습", "수유·식사·수면·배변 등 하루생활 모습", "또래에게 보이는 관심과 반응", "신체 움직임과 발달 모습", "아이가 잘하고 있는 점과 강점", "좋아하고 관심을 보이는 놀이와 탐색", "앞으로 조금 더 지원해 주면 좋을 부분", "말·몸짓·표정 등 의사표현 모습"] },
        { id: "f2", label: "2. 요즘 아이를 양육하면서 “왜 이런 모습을 보일까?”, “어떻게 도와주면 좋을까?” 하고 궁금했던 것이 있나요?", short: "양육 중 궁금한 점", type: "textarea", ph: "자유롭게 적어 주세요." },
        { id: "f3", label: "3. 앞으로 어린이집 생활을 하면서 아이가 조금 더 경험하거나 성장했으면 하는 부분은 무엇인가요?", short: "바라는 성장", type: "textarea", ph: "자유롭게 적어 주세요." },
        { id: "f4", label: "4. 그 밖에 이번 상담에서 선생님과 꼭 나누고 싶은 이야기나 질문이 있다면 자유롭게 적어주세요.", short: "나누고 싶은 이야기", type: "textarea", ph: "자유롭게 적어 주세요." }
      ]}
